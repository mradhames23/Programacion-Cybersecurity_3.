import tkinter as tk
from tkinter import messagebox, ttk
import mysql.connector
import re

# ---------------------------------
# CONEXIÓN A BASE DE DATOS
# ---------------------------------
def conectar_bd():
    try:
        conexion = mysql.connector.connect(
            host="localhost",
            user="root",
            password="",  # tu contraseña de XAMPP (si no tienes, déjala vacía)
            database="gestor_contrasenas"
        )
        return conexion
    except mysql.connector.Error as e:
        messagebox.showerror("Error", f"No se pudo conectar a MySQL: {e}")
        return None

# ------------------------------------------------
# FUNCIÓN PARA MEDIR LA FUERZA DE LA CONTRASEÑA
# ------------------------------------------------
def verificar_fuerza(password):
    if len(password) < 6:
        return "Débil"
    if not re.search(r"[A-Z]", password):
        return "Media"
    if not re.search(r"[0-9]", password):
        return "Media"
    if not re.search(r"[!@#$%^&*]", password):
        return "Fuerte"
    return "Fuerte"

# -----------------------------------------
# REGISTRAR USUARIO EN MYSQL
# -----------------------------------------
def registrar_usuario():
    username = entry_user.get()
    password = entry_pass.get()

    if username == "" or password == "":
        messagebox.showwarning("Aviso", "Todos los campos son obligatorios.")
        return

    fortaleza = verificar_fuerza(password)

    conexion = conectar_bd()
    if conexion:
        cursor = conexion.cursor()
        sql = "INSERT INTO usuarios (username, password, fortaleza) VALUES (%s, %s, %s)"
        cursor.execute(sql, (username, password, fortaleza))
        conexion.commit()
        conexion.close()

        messagebox.showinfo("Éxito", f"Usuario registrado.\nContraseña: {fortaleza}")
        cargar_tabla()
        entry_user.delete(0, tk.END)
        entry_pass.delete(0, tk.END)

# -----------------------------------------
# CARGAR DATOS EN TABLA
# -----------------------------------------
def cargar_tabla():
    conexion = conectar_bd()
    if conexion:
        cursor = conexion.cursor()
        cursor.execute("SELECT username, fortaleza, fecha FROM usuarios")
        registros = cursor.fetchall()
        conexion.close()

        tabla.delete(*tabla.get_children())
        for fila in registros:
            tabla.insert("", "end", values=fila)

# -----------------------------------------
# INTERFAZ TKINTER
# -----------------------------------------
ventana = tk.Tk()
ventana.title("Gestor de Contraseñas Seguras")
ventana.geometry("500x450")

tk.Label(ventana, text="Usuario:").pack()
entry_user = tk.Entry(ventana)
entry_user.pack()

tk.Label(ventana, text="Contraseña:").pack()
entry_pass = tk.Entry(ventana, show="*")
entry_pass.pack()

tk.Button(ventana, text="Registrar", command=registrar_usuario).pack(pady=10)

# Tabla
tabla = ttk.Treeview(ventana, columns=("Usuario", "Fortaleza", "Fecha"), show="headings")
tabla.heading("Usuario", text="Usuario")
tabla.heading("Fortaleza", text="Fortaleza")
tabla.heading("Fecha", text="Fecha Registro")
tabla.pack(fill="both", expand=True)

cargar_tabla()

ventana.mainloop()
