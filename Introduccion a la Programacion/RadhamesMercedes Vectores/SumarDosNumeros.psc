Algoritmo Principal
	Definir a, b, total Como Entero
	Escribir 'Ingrese el primer número: '
	Leer a
	Escribir 'Ingrese el segundo número: '
	Leer b
	total <- Sumar(a,b)
	Escribir 'La suma es: ', total
FinAlgoritmo
